{
  "name": "autosql",
  "version": "2.5.2",
  "description": "An auto-parser of JSON into SQL.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bench": "jest --config jest.bench.config.js --runInBand",
    "prepublishOnly": "npm run test && npm run build",
    "testPublish": "tsc && npm pack",
    "prepare": "npm run build",
    "db:up": "docker compose -f tests/docker-init/docker-compose.yml up -d --wait",
    "db:wait": "docker compose -f tests/docker-init/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f tests/docker-init/docker-compose.yml down"
  },
  "keywords": [
    "MySQL",
    "PGSQL",
    "automation",
    "laziness",
    "JSON",
    "typescript",
    "sql",
    "sql-parser",
    "database",
    "orm"
  ],
  "author": "w@walterchoi.com",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "jest": "^30.5.1",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "ssh2": "^1.16.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "mssql": "^11.0.1 || ^12.0.0",
    "mysql2": "^3.23.1",
    "pg": "^8.0.3",
    "pg-copy-streams": "^7.0.0",
    "ssh2": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-copy-streams": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "overrides": {
    "handlebars": "4.7.9",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.12",
    "@babel/core": "^7.29.7"
  },
  "bugs": {
    "url": "https://github.com/walterchoi/autosql/issues"
  },
  "homepage": "https://github.com/walterchoi/autosql#readme"
}
